        "inputSchema": "={\n  \"type\": \"object\",\n  \"properties\": {\n    \"response\": {\n      \"type\": \"string\"\n    },\n    \"name\": {\n      \"type\": \"string\"\n    },\n    \"phone\": {\n      \"type\": \"string\"\n    },\n    \"email\": {\n      \"type\": \"string\"\n    },\n    \"intent\": {\n      \"type\": \"string\"\n    },\n    \"property_type\": {\n      \"type\": \"string\"\n    },\n    \"location\": {\n      \"type\": \"string\"\n    },\n    \"budget\": {\n      \"type\": \"string\"\n    },\n    \"bedrooms\": {\n      \"type\": \"string\"\n    },\n    \"area_requirement\": {\n      \"type\": \"string\"\n    },\n    \"financing\": {\n      \"type\": \"string\"\n    },\n    \"property_details\": {\n      \"type\": \"string\"\n    },\n    \"preferred_date\": {\n      \"type\": \"string\"\n    },\n    \"preferred_time\": {\n      \"type\": \"string\"\n    },\n    \"status\": {\n      \"type\": \"string\"\n    },\n    \"notes\": {\n      \"type\": \"string\"\n    },\n    \"handoff\": {\n      \"type\": \"boolean\"\n    },\n    \"lead_ready\": {\n      \"type\": \"boolean\"\n    },\n    \"viewing_intent\": {\n      \"type\": \"boolean\"\n    }\n  },\n  \"required\": [\n    \"response\",\n    \"name\",\n    \"phone\",\n    \"email\",\n    \"intent\",\n    \"property_type\",\n    \"location\",\n    \"budget\",\n    \"bedrooms\",\n    \"area_requirement\",\n    \"financing\",\n    \"property_details\",\n    \"preferred_date\",\n    \"preferred_time\",\n    \"status\",\n    \"notes\",\n    \"handoff\",\n    \"lead_ready\",\n    \"viewing_intent\"\n  ],\n  \"additionalProperties\": false\n}"
